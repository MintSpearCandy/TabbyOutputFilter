{
  "name": "tabby-output-filter",
  "version": "0.4.1",
  "description": "Stream keyword/regex filtered output of one terminal into another terminal pane",
  "keywords": [
    "tabby-plugin"
  ],
  "main": "dist/index.js",
  "typings": "dist/index.d.ts",
  "scripts": {
    "build": "webpack --progress --color",
    "watch": "webpack --progress --color --watch",
    "typecheck": "tsc --noEmit",
    "test": "tsc src/lineFilter.ts --outDir test-build --module commonjs --target es2019 --esModuleInterop --skipLibCheck && node test/lineFilter.test.js",
    "stress": "node test/stress.js --benchmark",
    "stress:live": "node test/stress.js",
    "package": "node scripts/package.js",
    "package:install": "node scripts/package.js --install",
    "prepublishOnly": "npm run build"
  },
  "files": [
    "dist"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@angular/common": "^7.2.8",
    "@angular/core": "^7.2.8",
    "@angular/forms": "^7.2.8",
    "@angular/platform-browser": "^7.2.8",
    "@tabby-gang/to-string-loader": "^1.1.7-beta.2",
    "@types/node": "^14.14.35",
    "@types/webpack-env": "^1.16.0",
    "ansi-colors": "^3.2.4",
    "apply-loader": "^2.0.0",
    "awesome-typescript-loader": "^5.2.1",
    "css-loader": "^5.1.1",
    "pug": "^2.0.3",
    "pug-loader": "^2.4.0",
    "rxjs": "^6.2.1",
    "sass": "^1.32.13",
    "sass-loader": "^11.0.1",
    "strip-ansi": "^5.0.0",
    "style-loader": "^2.0.0",
    "tabby-core": "1.0.231-nightly.0",
    "tabby-settings": "1.0.231-nightly.0",
    "tabby-terminal": "1.0.231-nightly.0",
    "typescript": "4.2.3",
    "webpack": "^5.24.4",
    "webpack-cli": "^4.5.0"
  },
  "peerDependencies": {
    "@angular/core": "^4.0.1"
  }
}
